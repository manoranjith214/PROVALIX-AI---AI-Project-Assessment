# Frontend API URL (points to Express backend)
VITE_API_URL=http://localhost:5000
VITE_API_BASE_URL=http://localhost:5000/api

# Supabase Public Configuration (Optional - for client-side Auth)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional OAuth redirect URL override (defaults to https://provalix-ai.vercel.app/auth/callback in production, or local origin in dev)
VITE_AUTH_REDIRECT_URL=https://provalix-ai.vercel.app/auth/callback
