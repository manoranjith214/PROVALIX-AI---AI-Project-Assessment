# ==============================================================================
# PROVALIX AI - FRONTEND ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# Backend API Endpoints (points to deployed Express backend on Render/Cloud)
# Development: http://localhost:5000 / http://localhost:5000/api
# Production: https://api.provalix.ai or https://your-backend.onrender.com/api
VITE_API_URL=https://api.provalix.ai
VITE_API_BASE_URL=https://api.provalix.ai/api

# Supabase Public Configuration (for client-side Auth & storage previews)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# OAuth Redirect URL
# Development: http://localhost:5173/auth/callback
# Production: https://provalix-ai.vercel.app/auth/callback
VITE_AUTH_REDIRECT_URL=https://provalix-ai.vercel.app/auth/callback
