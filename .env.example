# ==============================================================================
# PROVALIX AI — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to backend/.env and frontend/.env respectively and populate
# with your actual credentials. NEVER commit files containing actual secrets!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND CONFIGURATION (backend/.env)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development # development | test | production
API_PREFIX=/api
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=1

# Database Configuration (PostgreSQL via Supabase Pooler)
# Session pooler connection string:
DATABASE_URL="postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require"
# Direct URL used for Prisma migrations:
DIRECT_URL="postgresql://postgres:[db-password]@db.[project-ref].supabase.co:5432/postgres?sslmode=require"

# Supabase Service & Storage
SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-or-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="provalix-uploads"
STORAGE_DRIVER=local # local | supabase
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# Authentication Secrets (Generate with: openssl rand -base64 32)
JWT_SECRET="your-secure-random-256-bit-jwt-secret-min-32-chars"
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET="your-secure-random-256-bit-refresh-secret-min-32-chars"
JWT_REFRESH_EXPIRES_IN=30d

# Google Gemini AI Configuration
AI_PROVIDER=gemini # gemini | mock
GEMINI_API_KEY="your-google-ai-studio-gemini-api-key"
GEMINI_MODEL=gemini-3.8-flash # Primary model; automatically falls back to gemini-3.5-flash on 503 capacity spikes

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=150

# Optional External Plagiarism Provider
PLAGIARISM_PROVIDER=local # local | copyleaks
COPYLEAKS_API_KEY=""
COPYLEAKS_EMAIL=""

# Optional OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# 2. FRONTEND CONFIGURATION (frontend/.env)
# ------------------------------------------------------------------------------
VITE_API_URL="http://localhost:5000"
VITE_API_BASE_URL="http://localhost:5000/api"
VITE_SUPABASE_URL="https://[project-ref].supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-or-publishable-key"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-or-publishable-key"
VITE_AUTH_REDIRECT_URL="http://localhost:5173/auth/callback"
