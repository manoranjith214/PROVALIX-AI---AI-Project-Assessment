# ==============================================================================
# PROVALIX AI - BACKEND PRODUCTION & DEVELOPMENT ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER SETTINGS
# ------------------------------------------------------------------------------
PORT=5000
# Node Environment: "development" | "test" | "production"
NODE_ENV=production
API_PREFIX=/api
BACKEND_URL=https://api.provalix.ai
# Set to 1 behind a single reverse proxy (Render, AWS ALB, Vercel/Nginx), or false for local dev
TRUST_PROXY=1

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL via Prisma & Supabase)
# ------------------------------------------------------------------------------
# Session pooler connection string (with ?pgbouncer=true) or direct connection:
DATABASE_URL="postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct URL used for Prisma migrations (optional):
DIRECT_URL="postgresql://postgres:[db-password]@db.[project-ref].supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & JWT SECRETS
# ------------------------------------------------------------------------------
# In production, missing JWT secrets will cause the application to fail fast.
# Generate secure 32+ character random strings: `openssl rand -base64 32`
JWT_SECRET=your_production_jwt_secret_min_32_characters
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_production_refresh_token_secret_min_32_characters
JWT_REFRESH_EXPIRES_IN=30d

# ------------------------------------------------------------------------------
# 4. CORS & FRONTEND ORIGIN CONFIGURATION
# ------------------------------------------------------------------------------
# Production should only allow your deployed frontend domain(s) - never '*'
FRONTEND_URL=https://provalix-ai.vercel.app
CORS_ORIGIN=https://provalix-ai.vercel.app,https://provalix.ai

# ------------------------------------------------------------------------------
# 5. STORAGE CONFIGURATION
# ------------------------------------------------------------------------------
# Driver: "supabase" (production private buckets) | "local" (development ./uploads)
STORAGE_DRIVER=supabase
STORAGE_PROVIDER=supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=provalix-submissions
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# ------------------------------------------------------------------------------
# 6. AI PROVIDER CONFIGURATION
# ------------------------------------------------------------------------------
# Supported providers: "gemini" (production) | "mock" (development / testing only)
# NOTE: Production will fail safely with HTTP 503 if Gemini key is missing;
#       it will NOT silently output fake/mock evaluations in production.
AI_PROVIDER=gemini
GEMINI_API_KEY=your_google_ai_studio_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash

# ------------------------------------------------------------------------------
# 7. PLAGIARISM DETECTION PROVIDER
# ------------------------------------------------------------------------------
# Supported providers: "real" (production external API) | "mock" (development only)
# NOTE: Production will NOT fall back to mock results if external provider is unconfigured.
PLAGIARISM_PROVIDER=real
PLAGIARISM_API_KEY=your_commercial_or_custom_plagiarism_api_key
PLAGIARISM_SERVICE_URL=https://api.plagiarism-provider.com/v1

# ------------------------------------------------------------------------------
# 8. RATE LIMITING & ABUSE PROTECTION
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=150

# ------------------------------------------------------------------------------
# 9. OAUTH PROVIDERS (Optional)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
