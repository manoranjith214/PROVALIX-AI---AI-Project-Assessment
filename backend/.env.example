# Server Configuration
PORT=5000
NODE_ENV=production
API_PREFIX=/api
BACKEND_URL=http://localhost:5000

# Supabase Production PostgreSQL Database Connection
# Format for Supabase: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# Or Direct: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=


# Database Connection (PostgreSQL)
DATABASE_URL=

# Authentication Secrets (Generate secure 32+ character random strings in production)
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# Frontend & CORS Configuration
FRONTEND_URL=
CORS_ORIGIN=

# OAuth Configuration (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Storage Configuration
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# AI Provider Configuration
# Supported providers: "mock" (offline deterministic fallback) | "gemini" (Google Gemini API)
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

